<!DOCTYPE HTML>
<html>
	<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no"/>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<title>Resistance</title>
    <script src="3rd/jquery.min.js"></script>
    <script src="3rd/socket.io.min.js"></script>
    <link href="3rd/font-awesome.min.css" rel="stylesheet">
    <link href="3rd/bootstrap.min.css" rel="stylesheet">
    <link href="3rd/bootstrap-theme.min.css" rel="stylesheet">
    <script src="3rd/bootstrap.min.js"></script>
    <style>
      .label {
        font-size:100%;
      }
    </style>

		<script type="text/javascript">
      var playern = 0;
      var joined = 0;
      var started = false;
      var phase = 'proposal';
      var teamSize = 0;
      var proposeRound = -1;
      var proposalOpen = false;
      var currentVoten = 0;
      var myVoted = -1;
      function Fill(data) {
        if (data[0] == undefined) return;
        playern = data.n;
        started = true;
        phase = data.phase;
        if (proposeRound != data.current_round) {
          $('#name_checks input[type=checkbox]').prop('checked', false);
        }
        proposeRound = data.current_round;
        teamSize = proposeRound >= 0 ? data[proposeRound].n : 0;
        if (proposeRound < 0 || data[proposeRound].voten == 0) myVoted = -1;
        proposalOpen = data.proposal['text'] != undefined;
        currentVoten = proposeRound >= 0 ? data[proposeRound].voten : 0;
        $('#playern').html(data.n);
        $('#room').html(data.room);
        if (data.room == 'Lobby') {
          $('#gamepad').hide();
          $('#gameinstruction').show();
        } else {
          $('#gamepad').show();
          $('#gameinstruction').hide();
        }
        $('#spyn').html(data.param[5]);
        for (var i = 0; i < 5; ++i) {
          if (data[i].votes != undefined) {
            var html = '';
            var result = 1;
            for (var j in data[i].votes) {
              var vote = data[i].votes[j];
              if (vote == 1) html += ' <span class="label label-success">Pass</span>';
              else html += ' <span class="label label-danger">Fail</span>';
              if (vote == 0) --result;
            }
            if (playern >= 7 && i == 3) {
              if (result == 0) result = 1;
            }
            if (result == 1) {
              $('#' + i).parent().parent().parent().removeClass('panel-info');
              $('#' + i).parent().parent().parent().addClass('panel-success');
              $('#' + i).parent().parent().addClass('bg-success');
            } else {
              $('#' + i).parent().parent().parent().removeClass('panel-info');
              $('#' + i).parent().parent().parent().addClass('panel-danger');
              $('#' + i).parent().parent().addClass('bg-danger');
            }
            $('#' + i).html(html);
            $('#voters' + i).html(unescape(data[i].voters.join(', ')));
          } else {
            $('#' + i).html(data[i].voten);
            $('#voters' + i).html('');
            $('#' + i).parent().parent().parent().removeClass('panel-success');
            $('#' + i).parent().parent().parent().removeClass('panel-danger');
            $('#' + i).parent().parent().parent().addClass('panel-info');
            $('#' + i).parent().parent().removeClass('bg-success');
            $('#' + i).parent().parent().removeClass('bg-danger');
          }
          $('#voten' + i).html(data[i].n);
          if (i == 3 && playern >= 7) {
            $('#voten3').html(data[3].n + '*');
          }
        }
        html = '';
        for (var i in data.proposals) {
          var p = data.proposals[i];
          var votes = [];
          var yes = 0;
          var all = 0;
          for (var j in p) {
            if (j == 'who' || j == 'text' || j == 'round') continue;
            ++all;
            if (p[j] == 1) {
              votes.push(' <span class="label label-success">' + unescape(j) + '</span>');
              ++yes;
            } else {
              votes.push(' <span class="label label-danger">' + unescape(j) + '</span>');
            }
          }
          if (yes > all / 2.0) {
            html += '<li class="list-group-item list-group-item-success">';
          } else {
            html += '<li class="list-group-item list-group-item-danger">';
          }
          html += 'Mission ' + (p.round + 1) + ' - ' + unescape(p.who) + ': ' + unescape(p.text) + '<p>' + votes.join('') + '</p></li>';
        }
        $('#proposals').html(html);
        
        html = '';
        if (data.proposal['text'] != undefined) {
          var p = data.proposal;
          html += '<h3>Mission ' + (p.round + 1) + ': <span style="font-weight:bold">' + unescape(p.who) + '</span>: <span class="text-primary">' + unescape(p.text) + '</span></h3>'
          var votes = [];
          for (var j in p) {
            if (j == 'who' || j == 'text' || j == 'round') continue;
            votes.push('<span class="label label-warning">' + unescape(j) + '</span>');
          }
          html += '<p>' + votes.join(' ') + '</p>';
        }
        $('#proposal').html(html);
        UpdateButtons();
      }
      function UpdateButtons() {
        $('#startbtn').prop('disabled', !(room != 'Lobby' && joined >= 5 && joined <= 10));
        $('#yesbtn').prop('disabled', !(started && proposalOpen));
        $('#nobtn').prop('disabled', !(started && proposalOpen));
        UpdateVisibility();
        UpdateTeamLimit();
        UpdateMissionControls();
      }
      function UpdateVisibility() {
        var completed = proposeRound < 0 ? 5 : proposeRound;
        var showProposal = started && phase == 'proposal' && proposeRound >= 0;
        $('#proposalbox').toggle(showProposal);
        $('#prestart').toggle(!started);
        for (var i = 0; i < 5; ++i) {
          var revealed = started && (i < completed || (phase == 'mission' && i == proposeRound));
          $('#missionbox' + i).toggle(revealed);
        }
      }
      function UpdateMissionControls() {
        for (var i = 0; i < 5; ++i) {
          var current = started && i == proposeRound;
          $('#nextbadge' + i).toggle(current);
          $('button[onclick="Pass(' + i + ')"]').toggle(current).prop('disabled', !current || myVoted == i);
          $('button[onclick="Fail(' + i + ')"]').toggle(current).prop('disabled', !current || myVoted == i);
          $('button[onclick="ClearVote(' + i + ')"]').toggle(current).prop('disabled', !current || currentVoten == 0);
        }
      }
      function UpdateTeamLimit() {
        var boxes = $('#name_checks input[type=checkbox]');
        var checked = boxes.filter(':checked').length;
        boxes.each(function () {
          this.disabled = !this.checked && checked >= teamSize;
        });
        $('#proposebtn').prop('disabled', !(started && teamSize > 0 && checked == teamSize));
        if (proposeRound >= 0) {
          $('#teamhint').html('Next mission ' + (proposeRound + 1) + ': select exactly ' + teamSize + ' player(s) (' + checked + '/' + teamSize + ')');
        } else {
          $('#teamhint').html('No mission to propose');
        }
      }
      function Propose() {
        var team = [];
        $('#name_checks input[type=checkbox]').each(function () {
          if (this.checked) team.push(this.value);
        });
        socket.emit('propose', {team: team});
      }
      function Join(data) {
        if (room != data.room) {
          started = false;
          phase = 'proposal';
          teamSize = 0;
          proposeRound = -1;
          proposalOpen = false;
          currentVoten = 0;
          myVoted = -1;
        }
        $('#room').html(data.room);
        room = data.room;
        if (data.room == 'Lobby') {
          $('#gamepad').hide();
          $('#gameinstruction').show();
        } else {
          $('#gamepad').show();
          $('#gameinstruction').hide();
        }
        $('#startbtn').toggle(data.room != 'Lobby');
        joined = data.names.length;
        $('#joined').html(joined);
        var nameshtml = [];
        for (var i in data.names)
          nameshtml.push('<strong class="text-primary">' + unescape(data.names[i]) + '</strong>');
        $('#names').html(nameshtml.join(' | '));
        var html = '';
        for (var i in data.names) {
          var name = data.names[i];
          html += '<div class="checkbox"><label><input type="checkbox" value="' + name + '">' + unescape(name) + '</label></div>';
        }
        $('#name_checks').html(html);
        UpdateButtons();
      }
      var me = #name#;
      var room = #room#;
      var socket = null;
      function ChangeName() {
        me = prompt("Please enter your name", me == null ? "Harry Potter" : me);
        if (me == null) return;
        $.post('/setname', {name: me}, function(data) {
          console.log(data);
        });
        $('#me').html(me);
        if (socket != null) {
          socket.emit('me', {'name': escape(me)});
        }
      }
      function Connect() {
        if (me == null) {
          ChangeName();
        }
        $('#me').html(me);
        socket = io();
        socket.on('connect', function(data) {
          $('#WARNING').html('CONNECTED');
          socket.emit('me', {'name': escape(me), 'room': room});
        });
        socket.on('disconnect', function(data) {
          $('#WARNING').html('DISCONNECTED');
        });
        socket.on('votes', function(data) {
          Fill(data);
        });
        socket.on('join', function(data) {
          Join(data);
          $.post('/setname', {name: me, room: room}, function(data) {
            console.log(data);
          });
        });
        socket.on('role', function(data) {
          started = true;
          phase = 'proposal';
          myVoted = -1;
          UpdateButtons();
          if (data.role == 0) {
            var msg = '';
            if (data.spys.length == 2) {
              msg += 'Your partner is ';
              for (var i in data.spys) {
                if (unescape(data.spys[i]) == me) continue;
                msg += unescape(data.spys[i]) + '.';
              }
            } else {
              msg += 'Your partners are ';
              var s = 0;
              for (var i in data.spys) {
                if (unescape(data.spys[i]) == me) continue;
                if (s == data.spys.length - 2) msg += ' and ';
                else if (s != 0) msg += ', ';
                msg += unescape(data.spys[i]);
                ++s;
              }
              msg += '.';
            }
            alert(me + ', you are a SPY. ' + msg);
          } else {
            alert(me + ', you are a RESISTANCE MEMBER.');
          }
        });
      }
      $(document).on('change', '#name_checks input[type=checkbox]', UpdateTeamLimit);
      $(document).ready(Connect);
      function Start() {
        socket.emit('start');
      }
      function Pass(round) {
        myVoted = round;
        UpdateButtons();
        socket.emit('vote', {round: round, vote: 1});
      }
      function Fail(round) {
        myVoted = round;
        UpdateButtons();
        socket.emit('vote', {round: round, vote: 0});
      }
      function ClearVote(round) {
        socket.emit('clearvote', {round: round});
      }
      function Yes() {
        socket.emit('yes');
      }
      function No() {
        socket.emit('no');
      }
      function CreateRoom() {
        socket.emit('create');
      }
      function JoinRoom() {
        var room2 = prompt("Please enter room number");
        if (room2 == null) return;
        if (socket != null) {
          socket.emit('join', {'room': room2});
        }
      }
      function LeaveRoom() {
        socket.emit('leave');
      }
		</script>
	</head>
	<body>
    <nav class="navbar navbar-default">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="#"><i class="fa fa-rebel"></i> Resistance</a>
        </div>
				<p class="navbar-text">
					<a class="navbar-link" onclick="ChangeName()">
            <span style="font-weight:bolder;" id="me"></span>
          </a>
          <span class="label label-primary"><i class="fa fa-home"></i> <span id="room"></span></span>
          <span id="WARNING"><span class="text-success">CONNECTED</span>
        </p>
        <div class="navbar-collapse" id="navbar_collapse">
          <button class="btn navbar-btn btn-info" onclick="CreateRoom();"><i class="fa fa-lg fa-plus-square"></i> Create</button>
          <button class="btn navbar-btn btn-info" onclick="JoinRoom();"><i class="fa fa-lg fa-sign-in"></i> Join</button>
          <button class="btn navbar-btn btn-info" onclick="LeaveRoom();"><i class="fa fa-lg fa-sign-out"></i> Leave</button>
        </div>
      </div>
    </nav>
    <div class="container-fluid">
      <h2><button class="btn btn-danger" id="startbtn" style="display:none" disabled onclick="Start();"><i class="fa fa-lg fa-star"></i> Start</button> <i class="fa fa-home"></i> (<span style="font-weight:bolder;" id="joined"></span>): <span id="names"></span></h2>
      <div id="gamepad">
        <h4 id="prestart">Waiting for the game to start...</h4>
        <div class="row">
          <div class="col-lg-4 col-md-6" id="proposalbox" style="display:none">
            <div class="panel panel-primary">
              <div class="panel-heading">
                <i class="fa fa-users"></i> Players number: <span id="playern"></span>, <i class="fa fa-user-secret"></i> Spies number: <span id="spyn"></span>
              </div>
              <div class="panel-body">
                <ul class="list-group" id="proposals"></ul>
                <div class="well well-sm">
                  <div id="name_checks"></div>
                  <p id="teamhint" class="text-muted"></p>
                  <button class="btn btn-primary" id="proposebtn" disabled onclick="Propose()"><i class="fa fa-th-list"></i> Propose</button>
                </div>
                <div class="well well-sm" id="proposal"></div>
                <button class="btn btn-success" id="yesbtn" disabled onclick="Yes()"><i class="fa fa-thumbs-up"></i> Yes</button>
                <button class="btn btn-danger" id="nobtn" disabled onclick="No()"><i class="fa fa-thumbs-down"></i> No</button>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox0" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 1 (<span id="voten0"></span>) <span class="label label-warning" id="nextbadge0" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="0"></span></p>
                <p>Team: <span class="text-primary" id="voters0"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(0)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(0)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(0)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox1" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 2 (<span id="voten1"></span>) <span class="label label-warning" id="nextbadge1" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="1"></span></p>
                <p>Team: <span class="text-primary" id="voters1"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(1)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(1)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(1)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox2" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 3 (<span id="voten2"></span>) <span class="label label-warning" id="nextbadge2" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="2"></span></p>
                <p>Team: <span class="text-primary" id="voters2"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(2)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(2)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(2)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox3" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 4 (<span id="voten3"></span>) <span class="label label-warning" id="nextbadge3" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="3"></span></p>
                <p>Team: <span class="text-primary" id="voters3"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(3)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(3)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(3)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox4" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 5 (<span id="voten4"></span>) <span class="label label-warning" id="nextbadge4" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="4"></span></p>
                <p>Team: <span class="text-primary" id="voters4"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(4)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(4)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(4)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="well" id="gameinstruction">
        <h4>You are in the
          <span class="label label-primary"><i class="fa fa-home"></i> <span>Lobby</span></span>
          .
        </h4>
        <h4>Please 
          <button class="btn navbar-btn btn-info" onclick="CreateRoom();"><i class="fa fa-lg fa-plus-square"></i> Create</button>
          or
          <button class="btn navbar-btn btn-info" onclick="JoinRoom();"><i class="fa fa-lg fa-sign-in"></i> Join</button>
          a room.
        </h4>
      </div>
    </div>
	</body>
</html>
