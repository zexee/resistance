<!DOCTYPE HTML>
<html>
	<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no"/>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<title>抵抗组织</title>
    <script src="3rd/jquery.min.js"></script>
    <script src="3rd/socket.io.min.js"></script>
    <link href="3rd/font-awesome.min.css" rel="stylesheet">
    <link href="3rd/bootstrap.min.css" rel="stylesheet">
    <link href="3rd/bootstrap-theme.min.css" rel="stylesheet">
    <link href="chat.css" rel="stylesheet">
    <link href="ai.css" rel="stylesheet">
    <script src="3rd/bootstrap.min.js"></script>
    <script src="chat.js"></script>
    <script src="ai.js"></script>
    <style>
      .label {
        font-size:100%;
      }
      .label-small {
        font-size:14px;
        vertical-align:middle;
      }
      @media (max-width: 767px) {
        .navbar-collapse button[data-target="#rules-modal"] {
          float: none !important;
          display: block;
        }
      }
    </style>

		<script type="text/javascript">
      var playern = 0;
      var joined = 0;
      var started = false;
      var phase = 'proposal';
      var leader = null;
      var rejected = 0;
      var winner = null;
      var results = [];
      var missionTeams = [];
      var inTeam = false;
      var players = [];
      var teamSize = 0;
      var proposeRound = -1;
      var proposalOpen = false;
      var currentVoten = 0;
      var myVoted = -1;
      var reconsiderText = null;
      var forcedPid = false;
      var forcedName = false;
      var pid = #pid#;
      function EnsurePid() {
        // ?pid=name forces an identity, useful to simulate several players in one browser profile.
        try {
          var forced = new URLSearchParams(window.location.search).get('pid');
          if (forced != null && forced != '') {
            pid = forced;
            forcedPid = true;
            return;
          }
        } catch (e) {}
        if (pid == null) {
          pid = 'p' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
        }
      }
      EnsurePid();
      function HtmlEscape(s) {
        return $('<div/>').text(s == undefined ? '' : s).html();
      }
      function AttrEscape(s) {
        return HtmlEscape(s).replace(/"/g, '&quot;');
      }
      function PlayerById(p) {
        for (var i in players) {
          if (players[i].pid == p) return players[i];
        }
        return null;
      }
      function NameOfPid(p) {
        var player = PlayerById(p);
        return player == null ? null : player.name;
      }
      function RawName(name) {
        if (name == undefined) return '某人';
        try {
          return decodeURIComponent(name);
        } catch (e) {
          return name;
        }
      }
      function PlayerLabel(player) {
        if (player == null) return '某人';
        return (player.number != undefined ? player.number + '. ' : '') + RawName(player.name);
      }
      function LabelOfPid(p) {
        return PlayerLabel(PlayerById(p));
      }
      function NamesOfPids(pids) {
        var names = [];
        for (var i in pids) {
          names.push(LabelOfPid(pids[i]));
        }
        return names.join(', ');
      }
      function DisplayName(name) {
        return HtmlEscape(RawName(name));
      }
      function RoomLabel(r) {
        // 'Lobby' is an internal room id; everything else is a room number shown as-is.
        return r == 'Lobby' ? '大厅' : r;
      }
      function IsLeader() {
        return started && leader != null && leader == pid;
      }
      function IsProposalMeta(k) {
        return k == 'text' || k == 'who' || k == 'by' || k == 'round' || k == 'team' || k == 'auto';
      }
      function Fill(data) {
        if (data[0] == undefined) return;
        playern = data.n;
        started = true;
        phase = data.phase;
        leader = data.leader;
        rejected = data.rejected;
        winner = data.winner;
        results = data.results;
        missionTeams = data.mission_teams;
        players = data.players;
        inTeam = data.mission_team.indexOf(pid) >= 0;
        if (proposeRound != data.current_round) {
          $('#name_checks input[type=checkbox]').prop('checked', false);
        }
        proposeRound = data.current_round;
        teamSize = proposeRound >= 0 ? data[proposeRound].n : 0;
        if (proposeRound < 0 || data[proposeRound].voten == 0) myVoted = -1;
        proposalOpen = data.proposal['text'] != undefined;
        currentVoten = proposeRound >= 0 ? data[proposeRound].voten : 0;
        if (reconsiderText != null && (!proposalOpen || data.proposal['text'] != reconsiderText)) {
          reconsiderText = null;
          $('#reconsider').hide();
        }
        $('#playern').html(data.n);
        $('#room').html(RoomLabel(data.room));
        if (data.room == 'Lobby') {
          $('#gamepad').hide();
          $('#gameinstruction').show();
        } else {
          $('#gamepad').show();
          $('#gameinstruction').hide();
        }
        $('#spyn').html(data.param[5]);
        for (var i = 0; i < 5; ++i) {
          if (data[i].votes != undefined) {
            var html = '';
            for (var j in data[i].votes) {
              var vote = data[i].votes[j];
              if (vote == 1) html += ' <span class="label label-success">成功</span>';
              else html += ' <span class="label label-danger">失败</span>';
            }
            if (results[i] == 1) {
              $('#' + i).parent().parent().parent().removeClass('panel-info');
              $('#' + i).parent().parent().parent().addClass('panel-success');
              $('#' + i).parent().parent().addClass('bg-success');
            } else {
              $('#' + i).parent().parent().parent().removeClass('panel-info');
              $('#' + i).parent().parent().parent().addClass('panel-danger');
              $('#' + i).parent().parent().addClass('bg-danger');
            }
            $('#' + i).html(html);
          } else {
            $('#' + i).html(data[i].voten);
            $('#' + i).parent().parent().parent().removeClass('panel-success');
            $('#' + i).parent().parent().parent().removeClass('panel-danger');
            $('#' + i).parent().parent().parent().addClass('panel-info');
            $('#' + i).parent().parent().removeClass('bg-success');
            $('#' + i).parent().parent().removeClass('bg-danger');
          }
          $('#voters' + i).html(missionTeams[i] ? HtmlEscape(NamesOfPids(missionTeams[i])) : '');
          $('#voten' + i).html(data[i].n + ' 人');
          $('#failneed' + i).html('失败需 ' + data.fail_need[i] + ' 票');
          if (started && phase == 'mission' && i == proposeRound) {
            var waiting = [];
            var votedPids = {};
            for (var j in data[i].voted) votedPids[data[i].voted[j]] = 1;
            for (var j in missionTeams[i]) {
              if (votedPids[missionTeams[i][j]] == undefined) {
                waiting.push(HtmlEscape(LabelOfPid(missionTeams[i][j])));
              }
            }
            $('#votewait' + i).html(waiting.length ? '等待投票：' + waiting.join('、') : '');
          } else {
            $('#votewait' + i).html('');
          }
        }
        html = '';
        for (var i in data.proposals) {
          var p = data.proposals[i];
          var votes = [];
          var yes = 0;
          var all = 0;
          for (var j in p) {
            if (IsProposalMeta(j)) continue;
            ++all;
            if (p[j] == 1) {
              votes.push(' <span class="label label-success">' + HtmlEscape(LabelOfPid(j)) + '</span>');
              ++yes;
            } else {
              votes.push(' <span class="label label-danger">' + HtmlEscape(LabelOfPid(j)) + '</span>');
            }
          }
          if (p.auto) {
            html += '<li class="list-group-item list-group-item-info">';
          } else if (yes > all / 2.0) {
            html += '<li class="list-group-item list-group-item-success">';
          } else {
            html += '<li class="list-group-item list-group-item-danger">';
          }
          html += '任务 ' + (p.round + 1) + (p.auto ? '（自动通过）' : '') + ' · ' + DisplayName(p.who) + ' 提议：' + DisplayName(p.text) + '<p>' + votes.join('') + '</p></li>';
        }
        $('#proposals').html(html);
        
        html = '';
        if (data.proposal['text'] != undefined) {
          var p = data.proposal;
          html += '<h3>任务 ' + (p.round + 1) + '：<span style="font-weight:bold">' + DisplayName(p.who) + '</span> 提议：<span class="text-primary">' + DisplayName(p.text) + '</span></h3>'
          var votes = [];
          var votedPids = {};
          for (var j in p) {
            if (IsProposalMeta(j)) continue;
            votedPids[j] = 1;
            votes.push('<span class="label label-warning">' + HtmlEscape(LabelOfPid(j)) + '</span>');
          }
          html += '<p>' + votes.join(' ') + '</p>';
          var waiting = [];
          for (var k in players) {
            if (votedPids[players[k].pid] == undefined) waiting.push(HtmlEscape(PlayerLabel(players[k])));
          }
          if (waiting.length) {
            html += '<p class="text-muted">等待投票：' + waiting.join('、') + '</p>';
          }
        }
        $('#proposal').html(html);
        UpdateButtons();
      }
      function UpdateButtons() {
        $('#startbtn').prop('disabled', !(room != 'Lobby' && joined >= 5 && joined <= 10));
        $('#yesbtn').prop('disabled', !(started && proposalOpen && winner == null));
        $('#nobtn').prop('disabled', !(started && proposalOpen && winner == null));
        UpdateNames();
        UpdateVisibility();
        UpdateTeamLimit();
        UpdateMissionControls();
      }
      function UpdateNames() {
        var html = [];
        for (var i in players) {
          var player = players[i];
          var title = player.ai ? ' title="' + AttrEscape(player.model != undefined ? player.model : 'AI') + '"' : '';
          var item = '<strong class="' + (player.online === false ? 'text-muted' : 'text-primary') + '"' + title + '>' + HtmlEscape(PlayerLabel(player)) + '</strong>';
          if (player.ai) {
            item += ' <i class="fa fa-microchip text-info"' + title + '></i>';
            if (!started || winner != null) {
              item += ' <button type="button" class="btn btn-xs btn-danger aidel" data-pid="' + AttrEscape(player.pid) + '" title="移除 AI"><i class="fa fa-times"></i></button>';
            }
          }
          if (started && leader != null && player.pid == leader) {
            item += ' <i class="fa fa-star text-warning" title="领袖"></i>';
          }
          if (player.online === false) {
            item += ' <i class="fa fa-chain-broken" title="已断开"></i>';
          }
          html.push(item);
        }
        $('#names').html(html.join(' | '));
      }
      function UpdateVisibility() {
        var showProposal = started && phase == 'proposal' && proposeRound >= 0 && winner == null;
        $('#proposalbox').toggle(showProposal);
        $('#prestart').toggle(!started);
        $('#surrenderbtn').toggle(started && winner == null);
        $('#winner').toggle(winner != null);
        if (winner == 'resistance') $('#winner').html('<h3><span class="label label-success">抵抗组织获胜！</span></h3>');
        else if (winner == 'spies') $('#winner').html('<h3><span class="label label-danger">间谍获胜！</span></h3>');
        if (started) {
          var resistance = 0;
          var spies = 0;
          for (var i = 0; i < 5; ++i) {
            if (results[i] == 1) ++resistance;
            else if (results[i] == 0) ++spies;
          }
          $('#score').html(' <span class="label label-success label-small">任务成功 ' + resistance + '</span> <span class="label label-danger label-small">任务失败 ' + spies + '</span>');
        } else {
          $('#score').html('');
        }
        for (var i = 0; i < 5; ++i) {
          $('#missionbox' + i).toggle(started);
        }
      }
      function UpdateMissionControls() {
        for (var i = 0; i < 5; ++i) {
          var canVote = started && phase == 'mission' && i == proposeRound && inTeam && winner == null;
          $('#nextbadge' + i).toggle(started && i == proposeRound && winner == null);
          $('button[onclick="Pass(' + i + ')"]').toggle(canVote).prop('disabled', !canVote || myVoted == i);
          $('button[onclick="Fail(' + i + ')"]').toggle(canVote).prop('disabled', !canVote || myVoted == i);
          $('button[onclick="ClearVote(' + i + ')"]').toggle(canVote).prop('disabled', !canVote || currentVoten == 0);
        }
      }
      function UpdateTeamLimit() {
        var isLeader = IsLeader();
        var boxes = $('#name_checks input[type=checkbox]');
        var checked = boxes.filter(':checked').length;
        $('#name_checks').toggle(isLeader);
        boxes.each(function () {
          var player = PlayerById(this.value);
          this.disabled = (player != null && player.online === false) || (!this.checked && checked >= teamSize);
        });
        var canPropose = isLeader && teamSize > 0 && checked == teamSize && winner == null;
        $('#proposebtn').prop('disabled', !canPropose).toggle(isLeader);
        if (!isLeader) {
          $('#teamhint').html(leader != null ? '等待 ' + HtmlEscape(LabelOfPid(leader)) + ' 提议任务 ' + (proposeRound + 1) + ' 的队伍（' + teamSize + ' 人）。' : '');
        } else if (proposeRound >= 0) {
          $('#teamhint').html('你是领袖：任务 ' + (proposeRound + 1) + '：请恰好选择 ' + teamSize + ' 名玩家（' + checked + '/' + teamSize + '）。');
        } else {
          $('#teamhint').html('当前没有可提议的任务。');
        }
        if (started && proposeRound >= 0 && playern > 0) {
          var info = '被否决的提案：' + rejected + '/' + playern;
          if (rejected >= playern) info += ' —— 下一个提案将自动通过';
          $('#rejectinfo').html(info);
        } else {
          $('#rejectinfo').html('');
        }
      }
      function Propose() {
        var team = [];
        $('#name_checks input[type=checkbox]').each(function () {
          if (this.checked) team.push(this.value);
        });
        socket.emit('propose', {team: team});
      }
      function Join(data) {
        if (room != data.room) {
          started = false;
          phase = 'proposal';
          leader = null;
          rejected = 0;
          winner = null;
          results = [];
          missionTeams = [];
          inTeam = false;
          teamSize = 0;
          proposeRound = -1;
          proposalOpen = false;
          currentVoten = 0;
          myVoted = -1;
        }
        $('#room').html(RoomLabel(data.room));
        room = data.room;
        if (data.room == 'Lobby') {
          $('#gamepad').hide();
          $('#gameinstruction').show();
        } else {
          $('#gamepad').show();
          $('#gameinstruction').hide();
        }
        $('#startbtn').toggle(data.room != 'Lobby');
        players = data.players;
        joined = players.length;
        $('#joined').html(joined);
        UpdateNames();
        var html = '';
        for (var i in players) {
          var player = players[i];
          html += '<div class="checkbox"><label><input type="checkbox" value="' + HtmlEscape(player.pid) + '">' + HtmlEscape(PlayerLabel(player)) + '</label></div>';
        }
        $('#name_checks').html(html);
        UpdateButtons();
      }
      var me = #name#;
      var room = #room#;
      var socket = null;
      function SaveName() {
        var data = {};
        if (!forcedName && me != undefined) data.name = me;
        if (room != undefined) data.room = room;
        if (!forcedPid) data.pid = pid;
        $.post('/setname', data, function(res) {
          console.log(res);
        });
      }
      function ApplyForcedName() {
        // ?name=Bob forces the display name without overwriting the shared cookie.
        try {
          var forced = new URLSearchParams(window.location.search).get('name');
          if (forced != null && forced != '') {
            me = forced;
            forcedName = true;
          }
        } catch (e) {}
      }
      function ChangeName() {
        me = prompt("请输入你的名字", me == null ? "" : me);
        if (me == null || me == '') me = "Harry Potter";
        if (me.length > 20) me = me.slice(0, 20);
        SaveName();
        $('#me').html(HtmlEscape(me));
        if (socket != null) {
          socket.emit('me', {'name': encodeURIComponent(me), 'room': room, 'pid': pid});
        }
      }
      function Connect() {
        $('#lobbyrules').html($('#rules-modal .modal-body').html());
        ApplyForcedName();
        if (me == null) {
          ChangeName();
        }
        $('#me').html(HtmlEscape(me));
        socket = io();
        InitChat(socket);
        InitAi(socket);
        socket.on('connect', function(data) {
          $('#WARNING').html('已连接');
          socket.emit('me', {'name': encodeURIComponent(me), 'room': room, 'pid': pid});
        });
        socket.on('disconnect', function(data) {
          $('#WARNING').html('已断开');
        });
        socket.on('votes', function(data) {
          Fill(data);
        });
        socket.on('join', function(data) {
          Join(data);
          SaveName();
        });
        socket.on('proposal_reconsider', function(data) {
          if (data == undefined || data.pid != pid) return;
          reconsiderText = data.text != undefined ? data.text : '';
          $('#reconsider').show();
        });
        socket.on('role', function(data) {
          started = true;
          phase = 'proposal';
          myVoted = -1;
          UpdateButtons();
          if (data.role == 0) {
            var partners = [];
            for (var i in data.spys) {
              var spy = data.spys[i];
              if (spy.pid == pid) continue;
              partners.push(spy.number + '. ' + RawName(spy.name));
            }
            var msg = partners.length == 1 ? '你的搭档是 ' + partners[0] + '。' : '你的搭档是 ' + partners.join('、') + '。';
            alert(LabelOfPid(pid) + '，你是间谍。' + msg);
          } else {
            alert(LabelOfPid(pid) + '，你是抵抗组织成员。');
          }
        });
      }
      $(document).on('change', '#name_checks input[type=checkbox]', UpdateTeamLimit);
      $(document).on('click', '.aidel', function() {
        socket.emit('ai_remove', {pid: $(this).data('pid')});
      });
      $(document).ready(Connect);
      function Start() {
        if (started && winner == null && !confirm('重新开始游戏？')) return;
        socket.emit('start');
      }
      function Surrender() {
        if (!confirm('确定投降并让对方获胜吗？')) return;
        socket.emit('surrender');
      }
      function Pass(round) {
        myVoted = round;
        UpdateButtons();
        socket.emit('vote', {round: round, vote: 1});
      }
      function Fail(round) {
        myVoted = round;
        UpdateButtons();
        socket.emit('vote', {round: round, vote: 0});
      }
      function ClearVote(round) {
        socket.emit('clearvote', {round: round});
      }
      function Yes() {
        socket.emit('yes');
      }
      function No() {
        socket.emit('no');
      }
      function KeepProposal() {
        reconsiderText = null;
        $('#reconsider').hide();
        socket.emit('keep_proposal');
      }
      function CreateRoom() {
        socket.emit('create');
      }
      function JoinRoom() {
        var room2 = prompt("请输入房间号");
        if (room2 == null) return;
        if (socket != null) {
          socket.emit('join', {'room': room2});
        }
      }
      function LeaveRoom() {
        socket.emit('leave');
      }
		</script>
	</head>
	<body>
    <nav class="navbar navbar-default">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="#"><i class="fa fa-rebel"></i> 抵抗组织</a>
        </div>
				<p class="navbar-text">
					<a class="navbar-link" onclick="ChangeName()">
            <span style="font-weight:bolder;" id="me"></span>
          </a>
          <span class="label label-primary"><i class="fa fa-home"></i> <span id="room"></span></span>
          <span id="WARNING"><span class="text-success">已连接</span>
        </p>
        <div class="navbar-collapse" id="navbar_collapse">
          <button class="btn navbar-btn btn-info" onclick="CreateRoom();"><i class="fa fa-lg fa-plus-square"></i> 创建</button>
          <button class="btn navbar-btn btn-info" onclick="JoinRoom();"><i class="fa fa-lg fa-sign-in"></i> 加入</button>
          <button class="btn navbar-btn btn-info" onclick="LeaveRoom();"><i class="fa fa-lg fa-sign-out"></i> 离开</button>
          <button class="btn navbar-btn btn-info" id="aibtn" type="button" style="display:none"><i class="fa fa-lg fa-microchip"></i> 添加 AI</button>
          <button class="btn navbar-btn btn-info pull-right" data-toggle="modal" data-target="#rules-modal"><i class="fa fa-lg fa-book"></i> 规则</button>
        </div>
      </div>
    </nav>
    <div class="container-fluid">
      <h2><button class="btn btn-danger" id="startbtn" style="display:none" disabled onclick="Start();"><i class="fa fa-lg fa-star"></i> 开始</button> <button class="btn btn-warning" id="surrenderbtn" style="display:none" onclick="Surrender();"><i class="fa fa-lg fa-flag"></i> 投降</button> <i class="fa fa-home"></i> (<span style="font-weight:bolder;" id="joined"></span>): <span id="names"></span> <span id="score"></span></h2>
      <div id="gamepad">
        <h4 id="prestart">等待游戏开始……</h4>
        <div id="winner" style="display:none"></div>
        <div class="row">
          <div class="col-lg-4 col-md-6" id="proposalbox" style="display:none">
            <div class="panel panel-primary">
              <div class="panel-heading">
                <i class="fa fa-users"></i> 玩家人数：<span id="playern"></span>，<i class="fa fa-user-secret"></i> 间谍人数：<span id="spyn"></span>
              </div>
              <div class="panel-body">
                <div class="alert alert-warning" id="reconsider" style="display:none">
                  <i class="fa fa-comments"></i> 有人在聊天中发言了。你可以重新修订这个提案（重选队伍并点“提议”），或保留原提案。
                  <button class="btn btn-xs btn-default" onclick="KeepProposal()">保留</button>
                </div>
                <ul class="list-group" id="proposals"></ul>
                <div class="well well-sm">
                  <p id="rejectinfo" class="text-muted"></p>
                  <div id="name_checks"></div>
                  <p id="teamhint" class="text-muted"></p>
                  <button class="btn btn-primary" id="proposebtn" disabled onclick="Propose()"><i class="fa fa-th-list"></i> 提议</button>
                </div>
                <div class="well well-sm" id="proposal"></div>
                <button class="btn btn-success" id="yesbtn" disabled onclick="Yes()"><i class="fa fa-thumbs-up"></i> 赞成</button>
                <button class="btn btn-danger" id="nobtn" disabled onclick="No()"><i class="fa fa-thumbs-down"></i> 反对</button>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox0" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                任务 1（<span id="voten0"></span>，<span id="failneed0"></span>） <span class="label label-warning" id="nextbadge0" style="display:none">当前</span>
              </div>
              <div class="panel-body">
                <p>结果：<span id="0"></span></p>
                <p>队伍：<span class="text-primary" id="voters0"></span></p>
                <p id="votewait0" class="text-muted"></p>
                <div><button class="btn btn-success" disabled onclick="Pass(0)"><i class="fa fa-rebel"></i> 成功</button> <button class="btn btn-danger" disabled onclick="Fail(0)"><i class="fa fa-ban"></i> 失败</button> <button class="btn btn-primary" disabled onclick="ClearVote(0)"><i class="fa fa-undo"></i> 清除</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox1" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                任务 2（<span id="voten1"></span>，<span id="failneed1"></span>） <span class="label label-warning" id="nextbadge1" style="display:none">当前</span>
              </div>
              <div class="panel-body">
                <p>结果：<span id="1"></span></p>
                <p>队伍：<span class="text-primary" id="voters1"></span></p>
                <p id="votewait1" class="text-muted"></p>
                <div><button class="btn btn-success" disabled onclick="Pass(1)"><i class="fa fa-rebel"></i> 成功</button> <button class="btn btn-danger" disabled onclick="Fail(1)"><i class="fa fa-ban"></i> 失败</button> <button class="btn btn-primary" disabled onclick="ClearVote(1)"><i class="fa fa-undo"></i> 清除</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox2" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                任务 3（<span id="voten2"></span>，<span id="failneed2"></span>） <span class="label label-warning" id="nextbadge2" style="display:none">当前</span>
              </div>
              <div class="panel-body">
                <p>结果：<span id="2"></span></p>
                <p>队伍：<span class="text-primary" id="voters2"></span></p>
                <p id="votewait2" class="text-muted"></p>
                <div><button class="btn btn-success" disabled onclick="Pass(2)"><i class="fa fa-rebel"></i> 成功</button> <button class="btn btn-danger" disabled onclick="Fail(2)"><i class="fa fa-ban"></i> 失败</button> <button class="btn btn-primary" disabled onclick="ClearVote(2)"><i class="fa fa-undo"></i> 清除</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox3" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                任务 4（<span id="voten3"></span>，<span id="failneed3"></span>） <span class="label label-warning" id="nextbadge3" style="display:none">当前</span>
              </div>
              <div class="panel-body">
                <p>结果：<span id="3"></span></p>
                <p>队伍：<span class="text-primary" id="voters3"></span></p>
                <p id="votewait3" class="text-muted"></p>
                <div><button class="btn btn-success" disabled onclick="Pass(3)"><i class="fa fa-rebel"></i> 成功</button> <button class="btn btn-danger" disabled onclick="Fail(3)"><i class="fa fa-ban"></i> 失败</button> <button class="btn btn-primary" disabled onclick="ClearVote(3)"><i class="fa fa-undo"></i> 清除</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox4" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                任务 5（<span id="voten4"></span>，<span id="failneed4"></span>） <span class="label label-warning" id="nextbadge4" style="display:none">当前</span>
              </div>
              <div class="panel-body">
                <p>结果：<span id="4"></span></p>
                <p>队伍：<span class="text-primary" id="voters4"></span></p>
                <p id="votewait4" class="text-muted"></p>
                <div><button class="btn btn-success" disabled onclick="Pass(4)"><i class="fa fa-rebel"></i> 成功</button> <button class="btn btn-danger" disabled onclick="Fail(4)"><i class="fa fa-ban"></i> 失败</button> <button class="btn btn-primary" disabled onclick="ClearVote(4)"><i class="fa fa-undo"></i> 清除</button></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="well" id="gameinstruction">
        <h4>你当前位于
          <span class="label label-primary"><i class="fa fa-home"></i> <span>大厅</span></span>
          。
        </h4>
        <h4>请
          <button class="btn navbar-btn btn-info" onclick="CreateRoom();"><i class="fa fa-lg fa-plus-square"></i> 创建</button>
          或
          <button class="btn navbar-btn btn-info" onclick="JoinRoom();"><i class="fa fa-lg fa-sign-in"></i> 加入</button>
          一个房间。
        </h4>
        <h4>游戏规则</h4>
        <div id="lobbyrules"></div>
      </div>
    </div>
    <div class="modal fade" id="rules-modal" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="关闭"><span aria-hidden="true">&times;</span></button>
            <h4 class="modal-title">游戏规则</h4>
          </div>
          <div class="modal-body">
            <p>5-10 名玩家。每人秘密地是抵抗组织成员或间谍；间谍之间互相知道身份。</p>
            <ul>
              <li>游戏最多进行 5 个任务，先赢下 3 个任务的一方获胜。</li>
              <li>每个任务由领袖按任务卡上标示的人数提议一支队伍。</li>
              <li>全体玩家投票赞成或反对，严格多数即可通过该队伍。</li>
              <li>若提案被否决，领袖权传给下一位玩家。当每位玩家都提议过一次且全部被否决后，下一个提案将自动通过。</li>
              <li>队伍通过后，仅由队员投票成功或失败。一张失败即令任务失败；唯一的例外是 7 人及以上的 4 号任务，需要 2 张失败才失败。</li>
              <li>领袖按玩家顺序轮转，首位领袖随机产生。</li>
            </ul>
            <table class="table table-condensed">
              <thead><tr><th>玩家数</th><th>间谍数</th><th>任务队伍人数</th></tr></thead>
              <tbody>
                <tr><td>5</td><td>2</td><td>2 3 2 3 3</td></tr>
                <tr><td>6</td><td>2</td><td>2 3 4 3 4</td></tr>
                <tr><td>7</td><td>3</td><td>2 3 3 4 4</td></tr>
                <tr><td>8</td><td>3</td><td>3 4 4 5 5</td></tr>
                <tr><td>9</td><td>3</td><td>3 4 4 5 5</td></tr>
                <tr><td>10</td><td>4</td><td>3 4 4 5 5</td></tr>
              </tbody>
            </table>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">关闭</button>
          </div>
        </div>
      </div>
    </div>
	</body>
</html>
