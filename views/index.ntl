<!DOCTYPE HTML>
<html>
	<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no"/>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<title>Resistance</title>
    <script src="3rd/jquery.min.js"></script>
    <script src="3rd/socket.io.min.js"></script>
    <link href="3rd/font-awesome.min.css" rel="stylesheet">
    <link href="3rd/bootstrap.min.css" rel="stylesheet">
    <link href="3rd/bootstrap-theme.min.css" rel="stylesheet">
    <script src="3rd/bootstrap.min.js"></script>
    <style>
      .label {
        font-size:100%;
      }
      .label-small {
        font-size:14px;
        vertical-align:middle;
      }
    </style>

		<script type="text/javascript">
      var playern = 0;
      var joined = 0;
      var started = false;
      var phase = 'proposal';
      var leader = null;
      var rejected = 0;
      var winner = null;
      var results = [];
      var missionTeams = [];
      var inTeam = false;
      var playerNames = [];
      var teamSize = 0;
      var proposeRound = -1;
      var proposalOpen = false;
      var currentVoten = 0;
      var myVoted = -1;
      function IsLeader() {
        return started && leader != null && leader == escape(me);
      }
      function IsProposalMeta(k) {
        return k == 'text' || k == 'who' || k == 'round' || k == 'team' || k == 'auto';
      }
      function Fill(data) {
        if (data[0] == undefined) return;
        playern = data.n;
        started = true;
        phase = data.phase;
        leader = data.leader;
        rejected = data.rejected;
        winner = data.winner;
        results = data.results;
        missionTeams = data.mission_teams;
        inTeam = data.mission_team.indexOf(escape(me)) >= 0;
        if (proposeRound != data.current_round) {
          $('#name_checks input[type=checkbox]').prop('checked', false);
        }
        proposeRound = data.current_round;
        teamSize = proposeRound >= 0 ? data[proposeRound].n : 0;
        if (proposeRound < 0 || data[proposeRound].voten == 0) myVoted = -1;
        proposalOpen = data.proposal['text'] != undefined;
        currentVoten = proposeRound >= 0 ? data[proposeRound].voten : 0;
        $('#playern').html(data.n);
        $('#room').html(data.room);
        if (data.room == 'Lobby') {
          $('#gamepad').hide();
          $('#gameinstruction').show();
        } else {
          $('#gamepad').show();
          $('#gameinstruction').hide();
        }
        $('#spyn').html(data.param[5]);
        for (var i = 0; i < 5; ++i) {
          if (data[i].votes != undefined) {
            var html = '';
            for (var j in data[i].votes) {
              var vote = data[i].votes[j];
              if (vote == 1) html += ' <span class="label label-success">Pass</span>';
              else html += ' <span class="label label-danger">Fail</span>';
            }
            if (results[i] == 1) {
              $('#' + i).parent().parent().parent().removeClass('panel-info');
              $('#' + i).parent().parent().parent().addClass('panel-success');
              $('#' + i).parent().parent().addClass('bg-success');
            } else {
              $('#' + i).parent().parent().parent().removeClass('panel-info');
              $('#' + i).parent().parent().parent().addClass('panel-danger');
              $('#' + i).parent().parent().addClass('bg-danger');
            }
            $('#' + i).html(html);
          } else {
            $('#' + i).html(data[i].voten);
            $('#' + i).parent().parent().parent().removeClass('panel-success');
            $('#' + i).parent().parent().parent().removeClass('panel-danger');
            $('#' + i).parent().parent().parent().addClass('panel-info');
            $('#' + i).parent().parent().removeClass('bg-success');
            $('#' + i).parent().parent().removeClass('bg-danger');
          }
          $('#voters' + i).html(missionTeams[i] ? unescape(missionTeams[i].join(', ')) : '');
          $('#voten' + i).html(data[i].n + ' players');
          $('#failneed' + i).html(data.fail_need[i] + ' to fail');
        }
        html = '';
        for (var i in data.proposals) {
          var p = data.proposals[i];
          var votes = [];
          var yes = 0;
          var all = 0;
          for (var j in p) {
            if (IsProposalMeta(j)) continue;
            ++all;
            if (p[j] == 1) {
              votes.push(' <span class="label label-success">' + unescape(j) + '</span>');
              ++yes;
            } else {
              votes.push(' <span class="label label-danger">' + unescape(j) + '</span>');
            }
          }
          if (p.auto) {
            html += '<li class="list-group-item list-group-item-info">';
          } else if (yes > all / 2.0) {
            html += '<li class="list-group-item list-group-item-success">';
          } else {
            html += '<li class="list-group-item list-group-item-danger">';
          }
          html += 'Mission ' + (p.round + 1) + (p.auto ? ' (auto-passed)' : '') + ' - ' + unescape(p.who) + ': ' + unescape(p.text) + '<p>' + votes.join('') + '</p></li>';
        }
        $('#proposals').html(html);
        
        html = '';
        if (data.proposal['text'] != undefined) {
          var p = data.proposal;
          html += '<h3>Mission ' + (p.round + 1) + ': <span style="font-weight:bold">' + unescape(p.who) + '</span>: <span class="text-primary">' + unescape(p.text) + '</span></h3>'
          var votes = [];
          var votedNames = {};
          for (var j in p) {
            if (IsProposalMeta(j)) continue;
            votedNames[j] = 1;
            votes.push('<span class="label label-warning">' + unescape(j) + '</span>');
          }
          html += '<p>' + votes.join(' ') + '</p>';
          var waiting = [];
          for (var k in playerNames) {
            if (votedNames[playerNames[k]] == undefined) waiting.push(unescape(playerNames[k]));
          }
          if (waiting.length) {
            html += '<p class="text-muted">Waiting for: ' + waiting.join(', ') + '</p>';
          }
        }
        $('#proposal').html(html);
        UpdateButtons();
      }
      function UpdateButtons() {
        $('#startbtn').prop('disabled', !(room != 'Lobby' && joined >= 5 && joined <= 10));
        $('#yesbtn').prop('disabled', !(started && proposalOpen && winner == null));
        $('#nobtn').prop('disabled', !(started && proposalOpen && winner == null));
        UpdateNames();
        UpdateVisibility();
        UpdateTeamLimit();
        UpdateMissionControls();
      }
      function UpdateNames() {
        var html = [];
        for (var i in playerNames) {
          var name = playerNames[i];
          var item = '<strong class="text-primary">' + unescape(name) + '</strong>';
          if (started && leader != null && name == leader) {
            item += ' <i class="fa fa-star text-warning" title="Leader"></i>';
          }
          html.push(item);
        }
        $('#names').html(html.join(' | '));
      }
      function UpdateVisibility() {
        var showProposal = started && phase == 'proposal' && proposeRound >= 0 && winner == null;
        $('#proposalbox').toggle(showProposal);
        $('#prestart').toggle(!started);
        $('#winner').toggle(winner != null);
        if (winner == 'resistance') $('#winner').html('<h3><span class="label label-success">Resistance wins!</span></h3>');
        else if (winner == 'spies') $('#winner').html('<h3><span class="label label-danger">Spies win!</span></h3>');
        if (started) {
          var resistance = 0;
          var spies = 0;
          for (var i = 0; i < 5; ++i) {
            if (results[i] == 1) ++resistance;
            else if (results[i] == 0) ++spies;
          }
          $('#score').html(' <span class="label label-success label-small">Resistance ' + resistance + '</span> <span class="label label-danger label-small">Spies ' + spies + '</span>');
        } else {
          $('#score').html('');
        }
        for (var i = 0; i < 5; ++i) {
          $('#missionbox' + i).toggle(started);
        }
      }
      function UpdateMissionControls() {
        for (var i = 0; i < 5; ++i) {
          var canVote = started && phase == 'mission' && i == proposeRound && inTeam && winner == null;
          $('#nextbadge' + i).toggle(started && i == proposeRound && winner == null);
          $('button[onclick="Pass(' + i + ')"]').toggle(canVote).prop('disabled', !canVote || myVoted == i);
          $('button[onclick="Fail(' + i + ')"]').toggle(canVote).prop('disabled', !canVote || myVoted == i);
          $('button[onclick="ClearVote(' + i + ')"]').toggle(canVote).prop('disabled', !canVote || currentVoten == 0);
        }
      }
      function UpdateTeamLimit() {
        var isLeader = IsLeader();
        var boxes = $('#name_checks input[type=checkbox]');
        var checked = boxes.filter(':checked').length;
        $('#name_checks').toggle(isLeader);
        boxes.each(function () {
          this.disabled = !this.checked && checked >= teamSize;
        });
        var canPropose = isLeader && teamSize > 0 && checked == teamSize && winner == null;
        $('#proposebtn').prop('disabled', !canPropose).toggle(isLeader);
        if (!isLeader) {
          $('#teamhint').html(leader != null ? 'Waiting for ' + unescape(leader) + ' to propose mission ' + (proposeRound + 1) + ' (team of ' + teamSize + ')' : '');
        } else if (proposeRound >= 0) {
          $('#teamhint').html('You are the leader: mission ' + (proposeRound + 1) + ': select exactly ' + teamSize + ' players (' + checked + '/' + teamSize + ').');
        } else {
          $('#teamhint').html('No mission to propose');
        }
        if (started && proposeRound >= 0 && playern > 0) {
          var info = 'Rejected proposals: ' + rejected + '/' + playern;
          if (rejected >= playern) info += ' - the next proposal passes automatically';
          $('#rejectinfo').html(info);
        } else {
          $('#rejectinfo').html('');
        }
      }
      function Propose() {
        var team = [];
        $('#name_checks input[type=checkbox]').each(function () {
          if (this.checked) team.push(this.value);
        });
        socket.emit('propose', {team: team});
      }
      function Join(data) {
        if (room != data.room) {
          started = false;
          phase = 'proposal';
          leader = null;
          rejected = 0;
          winner = null;
          results = [];
          missionTeams = [];
          inTeam = false;
          teamSize = 0;
          proposeRound = -1;
          proposalOpen = false;
          currentVoten = 0;
          myVoted = -1;
        }
        $('#room').html(data.room);
        room = data.room;
        if (data.room == 'Lobby') {
          $('#gamepad').hide();
          $('#gameinstruction').show();
        } else {
          $('#gamepad').show();
          $('#gameinstruction').hide();
        }
        $('#startbtn').toggle(data.room != 'Lobby');
        joined = data.names.length;
        $('#joined').html(joined);
        playerNames = data.names;
        UpdateNames();
        var html = '';
        for (var i in data.names) {
          var name = data.names[i];
          html += '<div class="checkbox"><label><input type="checkbox" value="' + name + '">' + unescape(name) + '</label></div>';
        }
        $('#name_checks').html(html);
        UpdateButtons();
      }
      var me = #name#;
      var room = #room#;
      var socket = null;
      function ChangeName() {
        me = prompt("Please enter your name", me == null ? "Harry Potter" : me);
        if (me == null) return;
        $.post('/setname', {name: me}, function(data) {
          console.log(data);
        });
        $('#me').html(me);
        if (socket != null) {
          socket.emit('me', {'name': escape(me)});
        }
      }
      function Connect() {
        $('#lobbyrules').html($('#rules-modal .modal-body').html());
        if (me == null) {
          ChangeName();
        }
        $('#me').html(me);
        socket = io();
        socket.on('connect', function(data) {
          $('#WARNING').html('CONNECTED');
          socket.emit('me', {'name': escape(me), 'room': room});
        });
        socket.on('disconnect', function(data) {
          $('#WARNING').html('DISCONNECTED');
        });
        socket.on('votes', function(data) {
          Fill(data);
        });
        socket.on('join', function(data) {
          Join(data);
          $.post('/setname', {name: me, room: room}, function(data) {
            console.log(data);
          });
        });
        socket.on('role', function(data) {
          started = true;
          phase = 'proposal';
          myVoted = -1;
          UpdateButtons();
          if (data.role == 0) {
            var msg = '';
            if (data.spys.length == 2) {
              msg += 'Your partner is ';
              for (var i in data.spys) {
                if (unescape(data.spys[i]) == me) continue;
                msg += unescape(data.spys[i]) + '.';
              }
            } else {
              msg += 'Your partners are ';
              var s = 0;
              for (var i in data.spys) {
                if (unescape(data.spys[i]) == me) continue;
                if (s == data.spys.length - 2) msg += ' and ';
                else if (s != 0) msg += ', ';
                msg += unescape(data.spys[i]);
                ++s;
              }
              msg += '.';
            }
            alert(me + ', you are a SPY. ' + msg);
          } else {
            alert(me + ', you are a RESISTANCE MEMBER.');
          }
        });
      }
      $(document).on('change', '#name_checks input[type=checkbox]', UpdateTeamLimit);
      $(document).ready(Connect);
      function Start() {
        socket.emit('start');
      }
      function Pass(round) {
        myVoted = round;
        UpdateButtons();
        socket.emit('vote', {round: round, vote: 1});
      }
      function Fail(round) {
        myVoted = round;
        UpdateButtons();
        socket.emit('vote', {round: round, vote: 0});
      }
      function ClearVote(round) {
        socket.emit('clearvote', {round: round});
      }
      function Yes() {
        socket.emit('yes');
      }
      function No() {
        socket.emit('no');
      }
      function CreateRoom() {
        socket.emit('create');
      }
      function JoinRoom() {
        var room2 = prompt("Please enter room number");
        if (room2 == null) return;
        if (socket != null) {
          socket.emit('join', {'room': room2});
        }
      }
      function LeaveRoom() {
        socket.emit('leave');
      }
		</script>
	</head>
	<body>
    <nav class="navbar navbar-default">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="#"><i class="fa fa-rebel"></i> Resistance</a>
        </div>
				<p class="navbar-text">
					<a class="navbar-link" onclick="ChangeName()">
            <span style="font-weight:bolder;" id="me"></span>
          </a>
          <span class="label label-primary"><i class="fa fa-home"></i> <span id="room"></span></span>
          <span id="WARNING"><span class="text-success">CONNECTED</span>
        </p>
        <div class="navbar-collapse" id="navbar_collapse">
          <button class="btn navbar-btn btn-info" onclick="CreateRoom();"><i class="fa fa-lg fa-plus-square"></i> Create</button>
          <button class="btn navbar-btn btn-info" onclick="JoinRoom();"><i class="fa fa-lg fa-sign-in"></i> Join</button>
          <button class="btn navbar-btn btn-info" onclick="LeaveRoom();"><i class="fa fa-lg fa-sign-out"></i> Leave</button>
          <button class="btn navbar-btn btn-info" data-toggle="modal" data-target="#rules-modal"><i class="fa fa-lg fa-book"></i> Rules</button>
        </div>
      </div>
    </nav>
    <div class="container-fluid">
      <h2><button class="btn btn-danger" id="startbtn" style="display:none" disabled onclick="Start();"><i class="fa fa-lg fa-star"></i> Start</button> <i class="fa fa-home"></i> (<span style="font-weight:bolder;" id="joined"></span>): <span id="names"></span> <span id="score"></span></h2>
      <div id="gamepad">
        <h4 id="prestart">Waiting for the game to start...</h4>
        <div id="winner" style="display:none"></div>
        <div class="row">
          <div class="col-lg-4 col-md-6" id="proposalbox" style="display:none">
            <div class="panel panel-primary">
              <div class="panel-heading">
                <i class="fa fa-users"></i> Players number: <span id="playern"></span>, <i class="fa fa-user-secret"></i> Spies number: <span id="spyn"></span>
              </div>
              <div class="panel-body">
                <ul class="list-group" id="proposals"></ul>
                <div class="well well-sm">
                  <p id="rejectinfo" class="text-muted"></p>
                  <div id="name_checks"></div>
                  <p id="teamhint" class="text-muted"></p>
                  <button class="btn btn-primary" id="proposebtn" disabled onclick="Propose()"><i class="fa fa-th-list"></i> Propose</button>
                </div>
                <div class="well well-sm" id="proposal"></div>
                <button class="btn btn-success" id="yesbtn" disabled onclick="Yes()"><i class="fa fa-thumbs-up"></i> Yes</button>
                <button class="btn btn-danger" id="nobtn" disabled onclick="No()"><i class="fa fa-thumbs-down"></i> No</button>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox0" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 1 (<span id="voten0"></span>, <span id="failneed0"></span>) <span class="label label-warning" id="nextbadge0" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="0"></span></p>
                <p>Team: <span class="text-primary" id="voters0"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(0)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(0)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(0)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox1" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 2 (<span id="voten1"></span>, <span id="failneed1"></span>) <span class="label label-warning" id="nextbadge1" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="1"></span></p>
                <p>Team: <span class="text-primary" id="voters1"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(1)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(1)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(1)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox2" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 3 (<span id="voten2"></span>, <span id="failneed2"></span>) <span class="label label-warning" id="nextbadge2" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="2"></span></p>
                <p>Team: <span class="text-primary" id="voters2"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(2)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(2)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(2)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox3" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 4 (<span id="voten3"></span>, <span id="failneed3"></span>) <span class="label label-warning" id="nextbadge3" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="3"></span></p>
                <p>Team: <span class="text-primary" id="voters3"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(3)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(3)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(3)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-3" id="missionbox4" style="display:none">
            <div class="panel panel-info">
              <div class="panel-heading">
                Mission 5 (<span id="voten4"></span>, <span id="failneed4"></span>) <span class="label label-warning" id="nextbadge4" style="display:none">Next</span>
              </div>
              <div class="panel-body">
                <p>Votes: <span id="4"></span></p>
                <p>Team: <span class="text-primary" id="voters4"></span></p>
                <div><button class="btn btn-success" disabled onclick="Pass(4)"><i class="fa fa-rebel"></i> Pass</button> <button class="btn btn-danger" disabled onclick="Fail(4)"><i class="fa fa-ban"></i> Fail</button> <button class="btn btn-primary" disabled onclick="ClearVote(4)"><i class="fa fa-undo"></i> Clear</button></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="well" id="gameinstruction">
        <h4>You are in the
          <span class="label label-primary"><i class="fa fa-home"></i> <span>Lobby</span></span>
          .
        </h4>
        <h4>Please 
          <button class="btn navbar-btn btn-info" onclick="CreateRoom();"><i class="fa fa-lg fa-plus-square"></i> Create</button>
          or
          <button class="btn navbar-btn btn-info" onclick="JoinRoom();"><i class="fa fa-lg fa-sign-in"></i> Join</button>
          a room.
        </h4>
        <h4>Game rules</h4>
        <div id="lobbyrules"></div>
      </div>
    </div>
    <div class="modal fade" id="rules-modal" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <h4 class="modal-title">Game rules</h4>
          </div>
          <div class="modal-body">
            <p>5-10 players. Each player is secretly a Resistance member or a Spy; the Spies know each other.</p>
            <ul>
              <li>The game lasts up to 5 missions. The first side to win 3 missions wins.</li>
              <li>Each mission the leader proposes a team of the size shown on the mission card.</li>
              <li>All players vote Yes or No; a strict majority approves the team.</li>
              <li>If a proposal is rejected, leadership passes to the next player. Once every player has proposed once and all were rejected, the next proposal passes automatically.</li>
              <li>When a team is approved, only its members vote Pass or Fail. One Fail fails the mission, except mission 4 with 7+ players, which needs 2 Fails.</li>
              <li>The leader rotates in player order; the first leader is random.</li>
            </ul>
            <table class="table table-condensed">
              <thead><tr><th>Players</th><th>Spies</th><th>Mission teams</th></tr></thead>
              <tbody>
                <tr><td>5</td><td>2</td><td>2 3 2 3 3</td></tr>
                <tr><td>6</td><td>2</td><td>2 3 4 3 4</td></tr>
                <tr><td>7</td><td>3</td><td>2 3 3 4 4</td></tr>
                <tr><td>8</td><td>3</td><td>3 4 4 5 5</td></tr>
                <tr><td>9</td><td>3</td><td>3 4 4 5 5</td></tr>
                <tr><td>10</td><td>4</td><td>3 4 4 5 5</td></tr>
              </tbody>
            </table>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
	</body>
</html>
